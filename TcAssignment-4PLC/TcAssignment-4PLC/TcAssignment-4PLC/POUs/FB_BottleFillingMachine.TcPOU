      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_BottleFillingMachine.SelectMode">
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_BottleFillingMachine.Start">
      <LineId Id="5" Count="0" />
      <LineId Id="10" Count="0" />
      <LineId Id="8" Count="1" />
    </LineIds>
    <LineIds Name="FB_BottleFillingMachine.Stop">
      <LineId Id="7" Count="1" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>