    </LineIds>
    <LineIds Name="TEST_FB_EnergySources.SolarPowerAtNight">
      <LineId Id="6" Count="0" />
      <LineId Id="8" Count="0" />
      <LineId Id="10" Count="0" />
      <LineId Id="12" Count="5" />
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="TEST_FB_EnergySources.WindPowerLimit">
