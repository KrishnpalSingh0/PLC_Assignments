<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <GVL Name="GVL_HMI" Id="{eee5d810-34a4-417b-8b93-008426bc6b73}">
    <Declaration><![CDATA[VAR_GLOBAL
(* operator buttons *)
bStart : BOOL := FALSE;
bStop : BOOL := FALSE;
bReset : BOOL := FALSE;

bAutoMode : BOOL := FALSE;
bManualMode : BOOL := FALSE;
bManualLoadShedding : BOOL := FALSE;

(* values shown on HMI *)
rSolarPower : REAL;
rWindPower : REAL;
rBatteryLevel : REAL;
rTotalLoad : REAL;
rGridPower : REAL;

rTemperature :REAL:= 30.0;
(* status messages *)

sDayPhase : STRING(50);
sSolarStatus : STRING(80);
sWindStatus : STRING(80);
sBatteryStatus : STRING(80);
sLoadStatus : STRING(80);
sGridStatus : STRING(80);
sSystemState : STRING(80);
sAlarmMessage : STRING(80);

bAlarmActive : BOOL;
rTotalGeneration: REAL;


bManualCharge : BOOL := FALSE;
bManualDischarge : BOOL := FALSE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>